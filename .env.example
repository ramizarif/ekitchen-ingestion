# eKitchen Recipe Parser API - Environment Configuration

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
ENVIRONMENT=development
DEBUG=True

# CORS (comma-separated origins, or * for all)
ALLOWED_ORIGINS=*

# OpenAI API (required for video/image parsing)
OPENAI_API_KEY=your_openai_api_key_here

# Spoonacular API (optional, for ingredient enrichment)
SPOONACULAR_API_KEY=your_spoonacular_api_key_here

# Parsing Timeouts (seconds)
WEBSITE_TIMEOUT=30
VIDEO_TIMEOUT=120
IMAGE_TIMEOUT=60
