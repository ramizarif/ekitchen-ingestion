# Recipe Discovery MCP Server Configuration
# Copy this file to .env and customize for your environment

# MCP Server Settings
SERVER_NAME=recipe-discovery-mcp
LOG_LEVEL=INFO

# Performance Settings
MAX_CONCURRENT_REQUESTS=10
REQUEST_TIMEOUT=30

# Rate Limiting Settings (Issue #6)
REQUESTS_PER_SECOND=2.0
MAX_RETRIES=3
RETRY_DELAY=1.0

# Scraping Configuration (Issue #6)
SCRAPING_TIMEOUT=30
MAX_CONCURRENT_SCRAPES=10
RESPECT_ROBOTS_TXT=true

# User Agent Settings
USER_AGENT="eKitchen Recipe Discovery Bot 1.0 (Respectful scraping for culinary data)"

# Development Settings
DEBUG_MODE=false
ENABLE_METRICS=true